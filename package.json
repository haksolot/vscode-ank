{
  "name": "ank",
  "displayName": "ank",
  "description": "Tasks and architecture decisions from your repository, in the editor. A client for the ank CLI.",
  "version": "0.1.0",
  "publisher": "haksolot",
  "license": "Apache-2.0",
  "author": "Sean Lamet",
  "homepage": "https://github.com/haksolot/vscode-ank",
  "repository": {
    "type": "git",
    "url": "https://github.com/haksolot/vscode-ank.git"
  },
  "bugs": {
    "url": "https://github.com/haksolot/vscode-ank/issues"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ank",
    "adr",
    "architecture decision record",
    "tasks",
    "agents"
  ],
  "engines": {
    "vscode": "^1.104.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.ank/config.yml"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ank.showLog",
        "title": "Show Log",
        "category": "ank"
      }
    ],
    "configuration": {
      "title": "ank",
      "properties": {
        "ank.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `ank` executable. Empty means the one on your `PATH`. Install it with `npm install -g @haksolot/ank`.",
          "scope": "machine-overridable"
        },
        "ank.agent": {
          "type": "string",
          "default": "",
          "markdownDescription": "The identity this window writes claims under, as `$ANK_AGENT`. Empty derives one from the editor. Two windows on one working tree sharing an identity are **one agent** to the claim refs: they share a claim instead of arbitrating over it, and the second is quietly refused work it should have been given.",
          "scope": "machine-overridable"
        }
      }
    }
  },
  "scripts": {
    "compile": "npm run check-types && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check-types": "tsc --noEmit",
    "compile:test": "tsc --project tsconfig.test.json",
    "lint": "eslint src",
    "test": "npm run compile:test && node --test \"out/test/unit/**/*.test.js\"",
    "test:integration": "npm run compile && npm run compile:test && vscode-test",
    "package": "npm run compile && vsce package",
    "vscode:prepublish": "npm run compile -- --production"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.1",
    "@types/vscode": "^1.104.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0"
  }
}
