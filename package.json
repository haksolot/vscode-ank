{
  "name": "ank",
  "displayName": "ank",
  "description": "Tasks and architecture decisions from your repository, in the editor. A client for the ank CLI.",
  "version": "0.1.0",
  "publisher": "haksolot",
  "license": "Apache-2.0",
  "author": "Sean Lamet",
  "homepage": "https://github.com/haksolot/vscode-ank",
  "repository": {
    "type": "git",
    "url": "https://github.com/haksolot/vscode-ank.git"
  },
  "bugs": {
    "url": "https://github.com/haksolot/vscode-ank/issues"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ank",
    "adr",
    "architecture decision record",
    "tasks",
    "agents"
  ],
  "engines": {
    "vscode": "^1.104.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.ank/config.yml"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ank.showLog",
        "title": "Show Log",
        "category": "ank"
      },
      {
        "command": "ank.refresh",
        "title": "Refresh",
        "category": "ank",
        "icon": "$(refresh)",
        "enablement": "ank.hasCorpus"
      },
      {
        "command": "ank.open",
        "title": "Open Entity",
        "category": "ank",
        "enablement": "ank.hasCorpus"
      },
      {
        "command": "ank.openFile",
        "title": "Open Entity File",
        "category": "ank",
        "icon": "$(go-to-file)",
        "enablement": "ank.hasCorpus"
      },
      {
        "command": "ank.status",
        "title": "Status",
        "category": "ank",
        "icon": "$(info)",
        "enablement": "ank.hasCorpus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ank",
          "title": "ank",
          "icon": "resources/ank.svg"
        }
      ]
    },
    "views": {
      "ank": [
        {
          "id": "ank.tasks",
          "name": "Tasks",
          "icon": "resources/ank.svg"
        },
        {
          "id": "ank.binds",
          "name": "Binds This File",
          "icon": "resources/ank.svg"
        },
        {
          "id": "ank.decisions",
          "name": "Decisions",
          "icon": "resources/ank.svg",
          "visibility": "collapsed"
        },
        {
          "id": "ank.graph",
          "name": "Graph",
          "icon": "resources/ank.svg",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ank.tasks",
        "contents": "No corpus in this workspace.\n\nank keeps tasks and architecture decisions in the repository, attached to the code they constrain.\n[Read about ank](https://github.com/haksolot/ank)",
        "when": "!ank.hasCorpus && ank.hasBinary"
      },
      {
        "view": "ank.tasks",
        "contents": "The ank executable was not found.\n\n$(terminal) npm install -g @haksolot/ank\n\nOr set the path to it in your settings.\n[Open Settings](command:workbench.action.openSettings?%22ank.path%22)",
        "when": "!ank.hasBinary"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ank.refresh",
          "when": "view == ank.tasks || view == ank.decisions || view == ank.graph",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "ank.openFile",
          "when": "viewItem =~ /^ank\\.(task|adr|spec)/",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "ank.open",
          "when": "false"
        },
        {
          "command": "ank.openFile",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "ank",
      "properties": {
        "ank.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `ank` executable. Empty means the one on your `PATH`. Install it with `npm install -g @haksolot/ank`.",
          "scope": "machine-overridable"
        },
        "ank.agent": {
          "type": "string",
          "default": "",
          "markdownDescription": "The identity this window writes claims under, as `$ANK_AGENT`. Empty derives one from the editor. Two windows on one working tree sharing an identity are **one agent** to the claim refs: they share a claim instead of arbitrating over it, and the second is quietly refused work it should have been given.",
          "scope": "machine-overridable"
        }
      }
    }
  },
  "scripts": {
    "compile": "npm run check-types && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check-types": "tsc --noEmit",
    "compile:test": "tsc --project tsconfig.test.json",
    "lint": "eslint src",
    "test": "npm run compile:test && node --test \"out/test/unit/**/*.test.js\"",
    "test:integration": "npm run compile && npm run compile:test && vscode-test",
    "package": "npm run compile && vsce package",
    "vscode:prepublish": "npm run compile -- --production"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.1",
    "@types/vscode": "^1.104.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0"
  }
}
